# Cornell box right wall -- unit quad in the YZ plane (x=0), winding gives +X normal.
# UVs tile the sidewall texture 8 times across and 6 times vertically.
mtllib textured_walls.mtl
v 0 0 0
v 0 1 0
v 0 1 1
v 0 0 1
vt 0 0
vt 8 0
vt 8 6
vt 0 6
vn 1 0 0
usemtl sidewall
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
