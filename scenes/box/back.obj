# Cornell box back wall -- unit quad in the XY plane (z=0), winding gives -Z normal.
# UVs tile the front texture 8 times horizontally and 6 times vertically.
mtllib textured_walls.mtl
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
vt 0 0
vt 8 0
vt 8 6
vt 0 6
vn 0 0 -1
usemtl front
f 1/1/1 3/3/1 2/2/1
f 1/1/1 4/4/1 3/3/1
